\u9879\\u76ee\\u9996\\u53f0\\u5957\\u5165\\u573a\\u4eea\\u5f0f\\uff0c\\u8463\\u4e8b\\u957f\\u5f20\\u6c38\\u519b\\u5230\\u573a\\uff0c\\u663e\\u793a\\u4e86\\u91cd\\u89c6\\u7a0b\\u5ea6\\u3002\\u6749\\u6749\\uff08\\u5c71\\u91d1\\uff09\\u65b9\\u9762\\uff1a\\u6749\\u6749\\u63a7\\u5236\\u6743\\u5df2\\u8f6c\\u4e3a\\u5b89\\u5fbd\\u56fd\\u8d44\\u59d4\\u6301\\u6709\\uff0c\\u6709\\u5229\\u4e8e\\u6d88\\u9664\\u6b64\\u524d\\u97e9\\u65b9\\u7ba1\\u7406\\u56e2\\u961f\\u5bf9\\u56fd\\u4ea7\\u6750\\u6599\\u7684\\u6392\\u65a5\\uff0c\\u4e3a\\u5929\\u7984TAC\\u819c\\u5bfc\\u5165\\u6749\\u6749\\u4f53\\u7cfb\\u63d0\\u4f9b\\u4e86\\u66f4\\u53cb\\u597d\\u7684\\u6c1b\\u56f4\\u3002`\\n  },\\n  {\\n    q: \\\"\\u6280\\u672f\\u6765\\u6e90\\u662f\\u4ec0\\u4e48\\uff1f\\u8bbe\\u5907\\u9009\\u578b\\u5982\\u4f55\\uff1f\\\",\\n    a: `\\u6280\\u672f\\u6765\\u6e90\\u4e3a\\u4eac\\u4e1c\\u65b9\\u5bfc\\u5165\\u7684\\u65e5\\u672c\\u9000\\u4f11\\u4e13\\u5bb6\\u56e2\\u961f\\uff0c\\u5929\\u7984\\u56e2\\u961f\\u8d1f\\u8d23\\u672c\\u571f\\u5316\\u5bf9\\u63a5\\u4e0e\\u5438\\u6536\\uff0c\\u975e\\u5b8c\\u5168\\u81ea\\u7814\\u3002\\u8463\\u79d8\\u660e\\u786e\\u8868\\u793a\\uff1a\\\"\\u4f60\\u8981\\u8bf4\\u6211\\u4eec\\u81ea\\u7814\\uff0c\\u6211\\u4e5f\\u89c9\\u5f97\\u4e0d\\u9760\\u8c31\\u3002\\\"\\u9762\\u677f\\u4ea7\\u4e1a\\u94fe\\u7684\\u6280\\u672f\\u89e3\\u6cd5\\u5f88\\u591a\\u6cbf\\u7528\\u8fd9\\u4e00\\u6a21\\u5f0f\\u2014\\u2014\\u4eac\\u4e1c\\u65b9\\u5f53\\u5e74\\u6536\\u8d2d\\u97e9\\u56fd\\u4ea7\\u7ebf\\u4e5f\\u662f\\u5148\\u4e70\\u7ebf\\u518d\\u8ddf\\u97e9\\u56fd\\u5e08\\u5085\\u5b66\\u3002\\u8bbe\\u5907\\u65b9\\u9762\\uff1a\\u4e0e\\u819c\\u63a5\\u89e6\\u7684\\u6838\\u5fc3\\u90e8\\u4ef6\\u5747\\u4e3a\\u8fdb\\u53e3\\u2014\\u2014\\u6392\\u8f8a\\uff08\\u610f\\u5927\\u5229\\uff09\\u3001\\u6cf5\\uff08\\u5fb7\\u56fd\\uff09\\u3001\\u94a2\\u5e26\\uff08\\u5965\\u5730\\u5229\\uff09\\u3001\\u78b3\\u7ea4\\u7ef4\\u8f8a\\uff08\\u65e5\\u672c\\u4e09\\u83f1\\uff09\\uff1b\\u975e\\u63a5\\u89e6\\u673a\\u68b0\\u4f20\\u52a8\\u90e8